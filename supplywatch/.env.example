APP_NAME=SupplyWatch
APP_VERSION=0.1.0
ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/supplywatch
RESEND_API_KEY=your_resend_key
RESEND_FROM_EMAIL=alerts@supplywatch.local
ENABLE_SCHEDULER=true
DEFAULT_RATE_LIMIT_FREE=100
# Optional: only used as a fallback if yfinance returns no usable price data.
# Leave blank to skip that fallback entirely -- nothing breaks without these.
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
